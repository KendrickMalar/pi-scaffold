{
  "name": "deterministic-scaffold",
  "version": "0.14.0",
  "private": true,
  "description": "Pi-native Scaffold workflow tools built on deterministic-gh",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.10.0"
  },
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KendrickMalar/deterministic-scaffold.git"
  },
  "pi": {
    "extensions": [
      "extensions/index.ts"
    ]
  },
  "bin": {
    "scaffold-watchdog": "bin/scaffold-watchdog",
    "scaffold-orchestrator-wait": "bin/scaffold-orchestrator-wait"
  },
  "files": [
    "bin/scaffold-watchdog",
    "bin/scaffold-orchestrator-wait",
    "extensions/**/*.ts",
    "dist/src",
    "resources",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "node -e \"process.getBuiltinModule('node:fs').rmSync('dist/src', {recursive: true, force: true})\" && tsc -p tsconfig.core.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.extension.json",
    "test": "npm run build && npm run build:test && node --test --test-timeout=60000 dist/test/*.test.js",
    "test:native": "python3 scripts/test-native-pi.py"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "^22.15.30",
    "jiti": "2.6.1",
    "typebox": "1.3.27",
    "typescript": "~5.9.2"
  }
}
